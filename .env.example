
# Backend API URL — nginx proxies all /api/* requests here.
# Use the service name when the backend runs in the same Compose project:
BACKEND_URL=http://backend:8000
# Use a full URL for an external / hosted backend:
# BACKEND_URL=https://api.example.com

# Dev-server API URL (used only during `npm run dev`, not in Docker).
VITE_API_URL=http://localhost:8000/api

# Host port for HTTP traffic (default: 80).
FRONTEND_PORT=80

# Host port for HTTPS traffic (default: 443).
# HTTPS is activated automatically when ssl/cert.pem and ssl/key.pem are
# mounted inside the container (see docker-compose.yml).
FRONTEND_HTTPS_PORT=443

VITE_GOOGLE_CLIENT_ID=
