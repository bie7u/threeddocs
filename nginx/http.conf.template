server {
    listen 80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Allow large file uploads (3D models).
    client_max_body_size 50m;

    # ── Gzip compression ────────────────────────────────────────────────────────
    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_proxied    any;
    gzip_types      text/plain text/css text/xml application/json
                    application/javascript application/xml+rss
                    image/svg+xml;

    # ── Security headers ────────────────────────────────────────────────────────
    add_header X-Frame-Options        "SAMEORIGIN"                       always;
    add_header X-Content-Type-Options "nosniff"                          always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin"  always;
    add_header X-XSS-Protection       "1; mode=block"                    always;

    # ── API proxy ───────────────────────────────────────────────────────────────
    # Forwards /api/* requests to the backend and passes httpOnly cookies.
    location /api/ {
        proxy_pass          ${BACKEND_URL};
        proxy_http_version  1.1;
        proxy_set_header    Host              $http_host;
        proxy_set_header    X-Real-IP         $remote_addr;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;

        # Rewrite any backend-set cookie Domain to the browser-facing host so
        # the browser always includes the cookie in subsequent requests.
        proxy_cookie_domain ~. $host;

        # Strip the Secure attribute from Set-Cookie so the browser stores
        # httpOnly cookies over plain HTTP.  Browsers silently discard cookies
        # marked Secure on non-HTTPS connections, which breaks cookie-based
        # authentication.
        # Also downgrade SameSite=None to SameSite=Lax: Chrome 80+ requires the
        # Secure attribute on any SameSite=None cookie (RFC 6265bis §5.3.7).
        # After nosecure removes Secure, a bare SameSite=None would be treated
        # as invalid and silently dropped.  SameSite=Lax is safe here because
        # all browser requests go to the same origin (the nginx host).
        proxy_cookie_flags ~ nosecure samesite=lax;

        add_header X-Frame-Options        "SAMEORIGIN"                       always;
        add_header X-Content-Type-Options "nosniff"                          always;
        add_header Referrer-Policy        "strict-origin-when-cross-origin"  always;
        add_header X-XSS-Protection       "1; mode=block"                    always;
    }

    # ── SPA fallback ────────────────────────────────────────────────────────────
    # Every request that does not match a real file is served index.html so
    # that React Router can handle the path on the client side.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
